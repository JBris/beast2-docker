FROM ubuntu:jammy-20240911.1

ARG BEAST_VERSION=v2.7.3
ENV DEBIAN_FRONTEND=noninteractive

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV BEAST_PACKAGE_PATH=/opt/beast-packages
ENV PATH="/opt/beast/bin:${PATH}"

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        openjdk-17-jre-headless && \
    rm -rf /var/lib/apt/lists/*

# Install BEAST 2.7.3
RUN curl -fsSL \
    "https://github.com/CompEvol/beast2/releases/download/${BEAST_VERSION}/BEAST.${BEAST_VERSION}.Linux.x86.tgz" \
    -o /tmp/beast.tgz && \
    tar -xzf /tmp/beast.tgz -C /opt && \
    rm /tmp/beast.tgz

# Use system Java 17 instead of the bundled JRE
RUN rm -rf /opt/beast/jre && \
    ln -s "${JAVA_HOME}" /opt/beast/jre

# Install ReMASTER
RUN mkdir -p "${BEAST_PACKAGE_PATH}" && \
    packagemanager -add ReMASTER -dir "${BEAST_PACKAGE_PATH}"

# Verify installed components
RUN beast -version

WORKDIR /workspace

ENTRYPOINT ["beast"]
CMD ["-version"]
